<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="OMNITURE_IS_ENABLED" value="false" />
    <add key="LOGGING_SEND_EMAIL_NOTIFICATION" value="false" />
    <add key="RESPONSE_PAGE_SIZE" value="20" />
    <!-- Synthetic test-only keys used by Cryptography to round-trip the session user id; not production values. -->
    <add key="KeyForConnectionStringPassphrase" value="synthetic-test-passphrase" />
    <add key="KeyForConnectionStringSalt" value="synthetic-test-salt" />
    <add key="KeyForConnectionStringVector" value="SyntheticIV12345" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>